# API principal
EXPO_PUBLIC_API_URL=https://tudominio.com/api_restaurante

# OAuth Google Sign-In. Debe ser el Web client ID, tambien usado por GOOGLE_CLIENT_ID en la API.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=tu_web_client_id.apps.googleusercontent.com

# Stripe para pagos desde la app movil
EXPO_PUBLIC_STRIPE_KEY=pk_test_...
EXPO_PUBLIC_ENABLE_CARD_PAYMENTS=false

# Activa el registro de tokens push nativos en builds de prueba/produccion
EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=true

# Gateway WebSocket que retransmite branch.config.updated
EXPO_PUBLIC_BRANCH_CONFIG_WS_URL=wss://tudominio.com/amare-events
