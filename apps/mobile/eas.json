{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://amarerestaurant.club/api_restaurante",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "environment": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://amarerestaurant.club/api_restaurante",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://amarerestaurant.club/api_restaurante",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
