{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "false"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://idactivos.digital/cafeuteq/api-php",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "false",
        "EXPO_PUBLIC_ENABLE_CARD_PAYMENTS": "true",
        "EXPO_PUBLIC_STRIPE_LIVE_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_WALLETS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "false",
        "EXPO_PUBLIC_ENABLE_CARD_PAYMENTS": "true",
        "EXPO_PUBLIC_STRIPE_LIVE_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_WALLETS": "true"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "environment": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://idactivos.digital/cafeuteq/api-php",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "false",
        "EXPO_PUBLIC_ENABLE_CARD_PAYMENTS": "true",
        "EXPO_PUBLIC_STRIPE_LIVE_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_WALLETS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://idactivos.digital/cafeuteq/api-php",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "false",
        "EXPO_PUBLIC_ENABLE_CARD_PAYMENTS": "true",
        "EXPO_PUBLIC_STRIPE_LIVE_MODE": "false",
        "EXPO_PUBLIC_ENABLE_NATIVE_WALLETS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
