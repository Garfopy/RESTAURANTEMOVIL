{
  "expo": {
    "name": "Amare",
    "slug": "amare-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "amare",
    "splash": {
      "image": "./assets/amare_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#191A2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amare.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Amare necesita tu ubicación para encontrar la sucursal más cercana.",
        "NSLocationAlwaysUsageDescription": "Amare necesita tu ubicación para el seguimiento de entregas.",
        "NSCameraUsageDescription": "Amare necesita la cámara para foto de perfil."
      },
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191A2E"
      },
      "package": "com.amare.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Amare necesita tu ubicación para encontrar sucursales cercanas."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.amare.app",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73bfa667-e98e-4da2-a789-78585e3599d6"
      }
    }
  }
}