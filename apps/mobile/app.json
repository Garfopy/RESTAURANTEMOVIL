{
  "expo": {
    "name": "Amare",
    "slug": "amare-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/amare_icon.png",
    "userInterfaceStyle": "light",
    "scheme": "amare",
    "splash": {
      "image": "./assets/amare_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#191A2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amare.app",
      "buildNumber": "2",
      "icon": "./assets/amare_icon_store.png",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.in-app-payments": [
          "merchant.com.amare.app"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Amare necesita tu ubicacion para encontrar la sucursal mas cercana.",
        "NSCameraUsageDescription": "Amare necesita la camara para escanear codigos QR y actualizar tu perfil.",
        "NSPhotoLibraryUsageDescription": "Amare necesita acceso a tus fotos para elegir imagenes de perfil.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "es"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/amare_icon.png",
        "backgroundColor": "#191A2E"
      },
      "package": "com.amare.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Amare necesita tu ubicacion para encontrar sucursales cercanas y preparar entregas.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Amare necesita la camara para escanear codigos QR y actualizar tu perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.859009059542-3c3159vd6maibhhgpjng9t63q5rjmsl1"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.amare.app",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "859009059542-0k2foa27gsah58utigs0kvp2nnsnvgnl.apps.googleusercontent.com",
      "eas": {
        "projectId": "db96a1b2-b362-4950-98a7-287432fb19c7"
      }
    },
    "owner": "impactos-digitales"
  }
}
