{
  "expo": {
    "name": "Amare",
    "slug": "amare-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/amare_icon.png",
    "userInterfaceStyle": "light",
    "scheme": "amare",
    "splash": {
      "image": "./assets/amare_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#191A2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amare.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Amare necesita tu ubicacion para encontrar la sucursal mas cercana.",
        "NSLocationAlwaysUsageDescription": "Amare necesita tu ubicacion para el seguimiento de entregas.",
        "NSCameraUsageDescription": "Amare necesita la camara para foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/amare_icon.png",
        "backgroundColor": "#191A2E"
      },
      "package": "com.amare.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#191A2E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Amare necesita tu ubicacion para encontrar sucursales cercanas."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.amare.app",
          "enableGooglePay": true
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73bfa667-e98e-4da2-a789-78585e3599d6"
      }
    },
    "owner": "impactosdigitales"
  }
}
