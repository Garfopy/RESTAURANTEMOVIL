{
  "expo": {
    "name": "UTEQ Cafetería",
    "slug": "amare-app",
    "newArchEnabled": false,
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/amare_icon.png",
    "userInterfaceStyle": "light",
    "scheme": "amare",
    "splash": {
      "image": "./assets/amare_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAECE0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uteq.cafeteria",
      "buildNumber": "1",
      "icon": "./assets/amare_icon_store.png",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.uteq.cafeteria"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "UTEQ Cafetería necesita tu ubicacion para encontrar la sucursal mas cercana.",
        "NSCameraUsageDescription": "UTEQ Cafetería necesita la camara para escanear codigos QR y actualizar tu perfil.",
        "NSPhotoLibraryUsageDescription": "UTEQ Cafetería necesita acceso a tus fotos para elegir imagenes de perfil.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "es"
        ]
      },
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAECE0"
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/amare_icon_adaptive.png",
        "backgroundColor": "#FAECE0"
      },
      "package": "com.uteq.cafeteria",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "image": "./assets/amare_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAECE0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UTEQ Cafetería necesita tu ubicacion para encontrar sucursales cercanas y preparar entregas.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "UTEQ Cafetería necesita la camara para escanear codigos QR y actualizar tu perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.uteq.cafeteria",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db96a1b2-b362-4950-98a7-287432fb19c7"
      }
    },
    "owner": "impactos-digitales"
  }
}
