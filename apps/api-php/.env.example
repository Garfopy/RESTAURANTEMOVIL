# ============================================================
# Config de UTEQ Cafetería — todo lo de abajo YA está listo para
# ese despliegue (dominio, bundle id, defaults fiscales). Lo único
# que falta antes de subir esto como `.env` real al servidor son
# las líneas marcadas "← CREDENCIAL": ahí van tus valores secretos
# reales, nunca los dejes en placeholder ni los subas a git.
# ============================================================

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario                 # ← CREDENCIAL
DB_PASS=tu_contraseña              # ← CREDENCIAL
DB_NAME=tu_base_de_datos           # ← CREDENCIAL

# API
APP_ENV=production
APP_DEBUG=false
APP_URL=https://idactivos.digital/cafeuteq/api-php
# Solo para sandbox/testing: permite liberar cuentas atoradas desde la app dev.
AMARE_ALLOW_TEST_SESSION_RESET=false

# JWT
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura   # ← CREDENCIAL (genera 64+ caracteres aleatorios)
JWT_EXPIRY=720

# Terminos adicionales separados por coma para el filtro preventivo del modo social
# (no se usa desde la app de UTEQ, el modo social ya no existe ahí — se deja por si el backend lo sigue usando en otro lado)
SOCIAL_BLOCKED_TERMS=

# Google OAuth (Sign-In con Google está oculto en la app de UTEQ; deja placeholder si no lo vas a activar)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com   # ← CREDENCIAL (si activas Google Sign-In)
GOOGLE_CLIENT_SECRET=tu_client_secret                       # ← CREDENCIAL (si activas Google Sign-In)

# Sign in with Apple — debe coincidir con ios.bundleIdentifier de apps/mobile/app.json
APPLE_CLIENT_ID=com.uteq.cafeteria

# Stripe — modo prueba (ver EXPO_PUBLIC_STRIPE_LIVE_MODE=false en apps/mobile/eas.json,
# todos los perfiles de build están en modo prueba por ahora)
STRIPE_SECRET_KEY=sk_test_...      # ← CREDENCIAL (llave secreta de prueba de tu proyecto Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...    # ← CREDENCIAL (del webhook que configures en Stripe)
STRIPE_LIVE_MODE=false

# FacturAPI (usa sk_test_... para pruebas sin validez fiscal)
FACTURAPI_SECRET_KEY=sk_test_...   # ← CREDENCIAL (solo si vas a facturar)
FACTURAPI_AUTO_STAMP=false
FACTURAPI_PRODUCT_KEY=90101501
FACTURAPI_UNIT_KEY=E48
FACTURAPI_TAX_INCLUDED=true
FACTURAPI_TAX_RATE=0.16

# Gateway que entrega branch.config.updated por FCM o WebSocket (opcional, déjalo vacío si no lo usas)
BRANCH_CONFIG_EVENT_WEBHOOK_URL=
BRANCH_CONFIG_EVENT_SECRET=

# Firebase Cloud Messaging HTTP v1 (push notifications — desactivadas en la app de UTEQ por ahora,
# deja placeholder salvo que las reactives)
FIREBASE_PROJECT_ID=tu-proyecto-firebase                              # ← CREDENCIAL (si reactivas push)
GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/firebase-service-account.json   # ← CREDENCIAL (si reactivas push)
# Alternativa si no puedes usar archivo:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS
CORS_ORIGIN=https://idactivos.digital

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
