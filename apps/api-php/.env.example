# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASS=tu_contraseña
DB_NAME=tu_base_de_datos

# API
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com/api

# JWT
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura
JWT_EXPIRY=720

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# FacturAPI (usa sk_test_... para pruebas sin validez fiscal)
FACTURAPI_SECRET_KEY=sk_test_...
FACTURAPI_AUTO_STAMP=false
FACTURAPI_PRODUCT_KEY=90101501
FACTURAPI_UNIT_KEY=E48
FACTURAPI_TAX_INCLUDED=true
FACTURAPI_TAX_RATE=0.16

# Gateway que entrega branch.config.updated por FCM o WebSocket
BRANCH_CONFIG_EVENT_WEBHOOK_URL=
BRANCH_CONFIG_EVENT_SECRET=

# CORS
CORS_ORIGIN=https://tudominio.com

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
